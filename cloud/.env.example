# agentlink cloud server (contracts/cloud-api.md "Server env"). Only the person who deploys the website needs this;
# people who join someone else's website don't.
# Copy to .env.local for local runs (cp .env.example .env.local) and replace every value. On Vercel, set the same
# names as project environment variables. Never commit the real values: .env.local is gitignored, this file is not.

# The owner's agentlink user name, and the master access code that signs in as that user (and only that user).
AGENTLINK_OWNER=your-username-here
AGENTLINK_MASTER_CODE=replace-with-output-of-openssl-rand-base64-32
# HS256 key for API session tokens (32+ characters).
AGENTLINK_SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
AGENTLINK_HUB_NAME=agentlink-cloud

# Supabase project: Settings > API. The URL and anon key are public; the service role key and JWT secret are server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Local development with `supabase start` (in cloud/): run `supabase status -o env` and copy API_URL, ANON_KEY,
# SERVICE_ROLE_KEY and JWT_SECRET into the four SUPABASE_* values above (SUPABASE_URL=http://127.0.0.1:54321).
