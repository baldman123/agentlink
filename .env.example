# Settings scripts/team-up.sh reads from the environment (see scripts/team-up.sh --help for all of them).
# Nothing loads this file on its own. To use it:
#   cp .env.example .env        # .env is gitignored; never commit it
#   (edit .env)
#   set -a; . ./.env; set +a; scripts/team-up.sh
# After the first successful run, team-up.sh remembers everything in data/local.env and data/.token
# (or data/.access-code in cloud mode), so later runs need no .env at all.

# Your agentlink user name: lowercase letters, digits, - or _. It must match the name your invite was for.
AGENTLINK_USER=your-username-here

# Joining a website (cloud mode): the address the owner gave you, https:// and no path.
AGENTLINK_HUB_URL=https://your-agentlink-site.vercel.app

# Joining a LAN hub instead: delete the AGENTLINK_HUB_URL line above (or set it to the http:// hint the
# invite printed) and set the hub id from the invite.
# AGENTLINK_HUB_ID=hub-id-from-your-invite

# Your invite token (LAN) or access code (cloud). Leave this commented out and team-up.sh asks for it
# without echoing it. If you do set it here, .env holds a secret: keep it off GitHub and out of chats.
# AGENTLINK_TOKEN=paste-your-invite-token-or-access-code-here

# Optional. Defaults shown.
# AGENTLINK_DAEMON_PORT=7701
# AGENTLINK_UI_PORT=7780
# C4_SESSION=claude4web
